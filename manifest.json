{
  "manifest_version": 3,
  "name": "AniList Waifu Roulette",
  "version": "1.0.0",
  "description": "Scannt deine AniList-Anime-Liste und wirft dir eine zufällige Waifu (Charakter) aus einem deiner Animes aus.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AniList Waifu Roulette"
  },
  "icons": {
    "48": "icon.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://graphql.anilist.co/*", "https://anilist.co/*"],
  "content_scripts": [
    {
      "matches": ["https://anilist.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["https://anilist.co/*"]
    }
  ]
}
